{# Pieces every vertical uses. Imported "with context", so biz (facts from the row), us (our studio) and v (the vertical's wording) are in scope. #}

{% macro heading() %}
  {% if biz.what %}<p class="kicker">{{ biz.what }}</p>{% endif %}
  <h1>{{ biz.name }}</h1>
  {% if biz.area %}<p class="where">{{ biz.area }}</p>{% endif %}
{% endmacro %}

{% macro actions(cls="actions") %}
{% if biz.tel or biz.whatsapp or biz.maps %}
<nav class="{{ cls }}" aria-label="Contact {{ biz.name }}">
  {% if biz.tel %}<a class="btn primary" href="{{ biz.tel }}"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2"/></svg>{{ v.call }}</a>{% endif %}
  {% if biz.whatsapp %}<a class="btn" href="{{ biz.whatsapp }}"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 12a8 8 0 0 1-11.8 7L4 20l1.1-4.9A8 8 0 1 1 21 12z"/></svg>Chat on WhatsApp</a>{% endif %}
  {% if biz.maps %}<a class="btn" href="{{ biz.maps }}"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 21s-7-6.2-7-11a7 7 0 0 1 14 0c0 4.8-7 11-7 11z"/><circle cx="12" cy="10" r="2.5"/></svg>Directions</a>{% endif %}
</nav>
{% endif %}
{% endmacro %}

{# A labelled empty frame. Only the first frame of a group carries the label; the rest are decorative. #}
{% macro ph(kind, label, extra=0) %}
<div class="ph" data-placeholder="{{ kind }}"><b>{{ label }}</b><small>Placeholder</small></div>
{% for _ in range(extra) %}<div class="ph" data-placeholder="{{ kind }}" aria-hidden="true"></div>{% endfor %}
{% endmacro %}

{% macro photos(cls="photos", extra=2) %}
<section class="s-photos" aria-labelledby="photos">
  <h2 id="photos">{{ v.photos_h }}</h2>
  <div class="{{ cls }}">{{ ph("photos", v.photos_ph, extra) }}</div>
</section>
{% endmacro %}

{% macro services(cls="services", extra=0) %}
<section class="s-services" aria-labelledby="services">
  <h2 id="services">{{ v.services_h }}</h2>
  <div class="{{ cls }}">{{ ph("services", v.services_ph, extra) }}</div>
</section>
{% endmacro %}

{# Real hours from the row replace the frame. #}
{% macro hours() %}
<section class="s-hours" aria-labelledby="hours">
  <h2 id="hours">{{ v.hours_h }}</h2>
  {% if biz.hours %}<p class="hours">{{ biz.hours }}</p>{% else %}{{ ph("hours", v.hours_ph) }}{% endif %}
</section>
{% endmacro %}

{% macro about() %}
{% if biz.what or biz.address or biz.area or biz.phone %}
<section class="s-about" aria-labelledby="about">
  <h2 id="about">{{ v.visit_h }}</h2>
  <dl>
    {% if biz.what %}<dt>What</dt><dd>{{ biz.what }}</dd>{% endif %}
    {% if biz.address %}<dt>Where</dt><dd>{{ biz.address }}</dd>{% elif biz.area %}<dt>Area</dt><dd>{{ biz.area }}</dd>{% endif %}
    {% if biz.phone %}<dt>Phone</dt><dd><a href="{{ biz.tel }}">{{ biz.phone }}</a></dd>{% endif %}
  </dl>
</section>
{% endif %}
{% endmacro %}

{# The enquiry section shows only our contact, never a form that collects anyone's details. #}
{% macro enquiry() %}
<section class="enquiry" aria-labelledby="enquiry">
  <h2 id="enquiry">Like this page?</h2>
  <p>It's a free concept by {{ us.studio }}{% if us.person and us.person != us.studio %} ({{ us.person }}){% endif %}. To talk about a website for {{ biz.name }}, get in touch with us:</p>
  <p class="links">
    {% if us.tel %}<a href="{{ us.tel }}">{{ us.phone }}</a>{% endif %}
    {% if us.mailto %}<a href="{{ us.mailto }}">{{ us.email }}</a>{% endif %}
  </p>
</section>
{% endmacro %}

{# Always the last thing on the page. #}
{% macro footer() %}
<footer>Details on this page come from public business listings and haven't been checked by {{ biz.name }}.</footer>
{% endmacro %}
