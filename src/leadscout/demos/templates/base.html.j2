<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex">
<meta name="referrer" content="no-referrer">
<title>{{ biz.name }}{% if biz.area %}, {{ biz.area }}{% endif %}</title>
<style>
:root{
{% block palette %}
  --bg:#f7f5f0;--ink:#1d1b18;--muted:#5e5850;--line:#e2ddd3;--accent:#8a4b12;--accent-ink:#fff;--soft:#efe8dc;
{% endblock %}
  --serif:Georgia,"Times New Roman",serif;
  --sans:system-ui,-apple-system,"Segoe UI",Roboto,"Noto Sans",sans-serif;
}
*{box-sizing:border-box}
html{-webkit-text-size-adjust:100%}
body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.55 var(--sans)}
a{color:inherit}
.concept{position:fixed;top:0;left:0;right:0;z-index:10;margin:0;padding:8px 16px;background:#1d1b18;color:#f7f5f0;font-size:13px;line-height:1.4;text-align:center}
.wrap{max-width:560px;margin:0 auto;padding:0 16px}
header{padding:88px 0 28px;border-bottom:1px solid var(--line);{% block header_bg %}{% endblock %}}
.kicker{margin:0 0 8px;color:var(--accent);font-size:13px;font-weight:600;letter-spacing:.08em;text-transform:uppercase}
h1{margin:0;font:400 clamp(34px,10vw,52px)/1.08 var(--serif);letter-spacing:-.01em;overflow-wrap:anywhere}
.where{margin:12px 0 0;color:var(--muted)}
.actions{display:grid;gap:10px;padding:24px 0}
.btn{display:flex;align-items:center;justify-content:center;gap:10px;min-height:52px;padding:12px 18px;border-radius:12px;border:1px solid var(--line);background:#fff;font-weight:600;text-decoration:none}
.btn.primary{background:var(--accent);border-color:var(--accent);color:var(--accent-ink)}
.btn svg{width:20px;height:20px;flex:none}
section{padding:24px 0;border-top:1px solid var(--line)}
h2{margin:0 0 12px;font:400 24px/1.2 var(--serif)}
dl{margin:0;display:grid;grid-template-columns:auto 1fr;gap:8px 16px}
dt{color:var(--muted)}
dd{margin:0;overflow-wrap:anywhere}
.enquiry{margin:8px 0 32px;padding:20px;border-radius:14px;background:var(--soft);border:0}
.enquiry p{margin:0 0 12px}
.enquiry .links{display:flex;flex-wrap:wrap;gap:8px 18px;font-weight:600}
footer{padding:0 0 40px;color:var(--muted);font-size:13px}
@media (min-width:720px){.actions{grid-template-columns:repeat(auto-fit,minmax(150px,1fr))}}
</style>
</head>
<body>
<p class="concept" role="note">Concept made by {{ us.studio }} for {{ biz.name }}. Not their official site.</p>
<div class="wrap">
<header>
  {% if biz.what %}<p class="kicker">{{ biz.what }}</p>{% endif %}
  <h1>{{ biz.name }}</h1>
  {% if biz.area %}<p class="where">{{ biz.area }}</p>{% endif %}
</header>

{% if biz.tel or biz.whatsapp or biz.maps %}
<nav class="actions" aria-label="Contact {{ biz.name }}">
  {% if biz.tel %}<a class="btn primary" href="{{ biz.tel }}"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2"/></svg>Call the {{ label }}</a>{% endif %}
  {% if biz.whatsapp %}<a class="btn" href="{{ biz.whatsapp }}"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 12a8 8 0 0 1-11.8 7L4 20l1.1-4.9A8 8 0 1 1 21 12z"/></svg>Chat on WhatsApp</a>{% endif %}
  {% if biz.maps %}<a class="btn" href="{{ biz.maps }}"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 21s-7-6.2-7-11a7 7 0 0 1 14 0c0 4.8-7 11-7 11z"/><circle cx="12" cy="10" r="2.5"/></svg>Directions</a>{% endif %}
</nav>
{% endif %}

<section aria-labelledby="about">
  <h2 id="about">{% block about_title %}About{% endblock %}</h2>
  <dl>
    {% if biz.what %}<dt>What</dt><dd>{{ biz.what }}</dd>{% endif %}
    {% if biz.address %}<dt>Where</dt><dd>{{ biz.address }}</dd>{% elif biz.area %}<dt>Area</dt><dd>{{ biz.area }}</dd>{% endif %}
    {% if biz.hours %}<dt>Hours</dt><dd>{{ biz.hours }}</dd>{% endif %}
    {% if biz.phone %}<dt>Phone</dt><dd><a href="{{ biz.tel }}">{{ biz.phone }}</a></dd>{% endif %}
  </dl>
</section>

<section class="enquiry" aria-labelledby="enquiry">
  <h2 id="enquiry">Like this page?</h2>
  <p>It's a free concept by {{ us.studio }}{% if us.person and us.person != us.studio %} ({{ us.person }}){% endif %}. To talk about a website for {{ biz.name }}, get in touch with us:</p>
  <p class="links">
    {% if us.tel %}<a href="{{ us.tel }}">{{ us.phone }}</a>{% endif %}
    {% if us.mailto %}<a href="{{ us.mailto }}">{{ us.email }}</a>{% endif %}
  </p>
</section>

<footer>Details on this page come from public business listings and haven't been checked by {{ biz.name }}.</footer>
</div>
</body>
</html>
